APP_MODE=fixture
# Fixture mode: in-memory demo accounts (owner@example.com / viewer@example.com), no persistence, blocked in production.
# Live mode requires PostgreSQL and server-side credentials. Never NEXT_PUBLIC_.
# APP_MODE=live
# APP_ORIGIN=https://app.example.com        # exact origin for CSRF checks and Secure cookies
# DATABASE_URL=postgres://fde_runtime:local-only@localhost:5432/fde   # non-superuser, no BYPASSRLS
# SERVICE_TOKEN=generate-a-long-random-value  # server-to-server bearer; browsers use the session cookie
# SERVICE_TENANT=demo
# SERVICE_PERMISSIONS=run:read,run:create,work_item:read   # permissions granted to the bearer client (default: member role)
