{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daehuikim/fde-service-template/showcase/schema.json",
  "title": "FDE Workbench showcase entry",
  "description": "One file per case in showcase/entries/<id>.json. Validated by scripts/showcase.mjs, which also checks that the file name equals id and that each skill exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "url", "authors", "date", "domain", "evidence", "skills", "language"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60},
    "title": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n|<>]+$"},
    "title_ko": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n|<>]+$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n|<>]+$"},
    "summary_ko": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n|<>]+$"},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source": {"type": "string", "format": "uri", "pattern": "^https://"},
    "authors": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"}},
    "date": {"type": "string", "format": "date"},
    "domain": {"enum": ["energy", "mobility", "customer-support", "partner-operations", "logistics", "manufacturing", "finance", "healthcare", "public-sector", "retail", "education", "developer-tools", "other"]},
    "evidence": {"enum": ["production", "pilot", "desk-review", "synthetic"]},
    "skills": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "language": {"enum": ["en", "ko", "en+ko"]},
    "featured": {"type": "boolean", "description": "Maintainers only."}
  }
}
