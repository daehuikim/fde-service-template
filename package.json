{
  "name": "fde-service-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @fde/web dev",
    "build": "pnpm --filter @fde/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "node scripts/check-tools.mjs && node scripts/contracts.mjs --check && pnpm docs:check && pnpm showcase:check && pnpm typecheck && pnpm test && pnpm diagram:check && pnpm assets:check && pnpm build",
    "eval:fixture": "node --import tsx packages/evaluation/run.ts",
    "diagram": "node scripts/diagram.mjs",
    "diagram:check": "node scripts/diagram.mjs --check",
    "doctor": "node scripts/toolkit.mjs doctor",
    "setup:tools": "node scripts/toolkit.mjs setup",
    "test:db": "node --import tsx qa/db.ts",
    "test:load": "node scripts/toolkit.mjs load",
    "eval:live": "node scripts/toolkit.mjs live",
    "db:migrate": "node --import tsx packages/db/migrate.ts",
    "security:scan": "node scripts/secrets.mjs",
    "contracts": "node scripts/contracts.mjs",
    "toolkit:doctor": "node scripts/toolkit.mjs doctor",
    "test:security": "node scripts/semgrep.mjs",
    "test:live-smoke": "node qa/live-smoke.mjs",
    "design:start": "node scripts/design-start.mjs",
    "design:check": "node scripts/design-check.mjs",
    "design:eval": "node scripts/design-eval.mjs",
    "brief": "node scripts/brief.mjs",
    "assets": "node scripts/brand-assets.mjs",
    "assets:check": "node scripts/brand-assets.mjs --check",
    "docs:check": "node scripts/docs-check.mjs",
    "showcase": "node scripts/showcase.mjs",
    "showcase:check": "node scripts/showcase.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "csv-parse": "7.0.3",
    "postgres": "3.4.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "type": "module"
}
