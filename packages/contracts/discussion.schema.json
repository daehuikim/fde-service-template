{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fde.discussion.v2",
  "description": "Multi-agent discussion record written by the host assistant following the fde-multi-agent-review skill: round 1 blind exploration, round 2 cross-review, a synthesizer subagent's synthesis, and round 3 goldfish verification. The app checks structure and references only; every judgment comes from the skill run.",
  "definitions": {
    "lens": {
      "enum": [
        "discovery",
        "field-debug",
        "problem-design",
        "validation",
        "security",
        "target-env",
        "cost",
        "compat-scale"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "claimId": {
      "type": "string",
      "pattern": "^[a-z-]{3,20}\\.[0-9]{1,3}$"
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "statement"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000
        },
        "context": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "kind",
        "confidence",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/claimId"
        },
        "statement": {
          "$ref": "#/definitions/text"
        },
        "kind": {
          "enum": [
            "observation",
            "hypothesis",
            "assumption",
            "vendor_claim"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,30}$"
          }
        },
        "evidence": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "nextCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "cost",
        "resolves"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z-]{3,20}\\.c[0-9]{1,3}$"
        },
        "action": {
          "$ref": "#/definitions/text"
        },
        "cost": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "resolves": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/claimId"
          }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "skill",
        "summary",
        "claims",
        "risks",
        "nextChecks",
        "questions",
        "durationMs"
      ],
      "properties": {
        "lens": {
          "$ref": "#/definitions/lens"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,60}$"
        },
        "summary": {
          "$ref": "#/definitions/text"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/claim"
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "nextChecks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/nextCheck"
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "target",
        "stance",
        "note"
      ],
      "properties": {
        "lens": {
          "$ref": "#/definitions/lens"
        },
        "target": {
          "$ref": "#/definitions/claimId"
        },
        "stance": {
          "enum": [
            "support",
            "challenge",
            "refine"
          ]
        },
        "note": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens",
        "round",
        "error"
      ],
      "properties": {
        "lens": {
          "$ref": "#/definitions/lens"
        },
        "round": {
          "enum": [
            1,
            2
          ]
        },
        "error": {
          "enum": [
            "timeout",
            "agent_error",
            "invalid_output",
            "cancelled"
          ]
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "problem",
        "lenses",
        "runner",
        "positions",
        "reviews",
        "failures",
        "synthesis",
        "verification"
      ],
      "properties": {
        "version": {
          "const": "2"
        },
        "problem": {
          "$ref": "#/definitions/problem"
        },
        "lenses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/lens"
          }
        },
        "positions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/position"
          },
          "minItems": 2
        },
        "reviews": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/definitions/review"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/failure"
          }
        },
        "verification": {
          "$ref": "#/definitions/verification"
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[a-z0-9.-]{2,60}$"
            },
            "model": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "synthesis": {
          "$ref": "#/definitions/synthesis"
        }
      }
    },
    "goldfishFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "scope",
        "finding",
        "recommendation"
      ],
      "properties": {
        "severity": {
          "enum": [
            "blocker",
            "major",
            "nit"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "finding": {
          "$ref": "#/definitions/text"
        },
        "recommendation": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "claims",
        "actions",
        "questions",
        "risks"
      ],
      "properties": {
        "headline": {
          "$ref": "#/definitions/text"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/claimId"
              },
              "status": {
                "enum": [
                  "consensus",
                  "contested",
                  "single_source"
                ]
              },
              "note": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "rationale"
            ],
            "properties": {
              "check": {
                "type": "string",
                "pattern": "^[a-z-]{3,20}\\.c[0-9]{1,3}$"
              },
              "rationale": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportHash",
        "verdict",
        "reviewers"
      ],
      "properties": {
        "reportHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verdict": {
          "enum": [
            "pass",
            "attention",
            "blocked",
            "incomplete"
          ]
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "status",
              "attempts",
              "findings"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,30}$"
              },
              "status": {
                "enum": [
                  "completed",
                  "not_run"
                ]
              },
              "attempts": {
                "enum": [
                  1,
                  2
                ]
              },
              "findings": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "$ref": "#/definitions/goldfishFinding"
                }
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/definitions/transcript"
}
