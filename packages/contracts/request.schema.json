{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fde.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "title",
    "department",
    "amount"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{1,32}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "department": {
      "enum": [
        "operations",
        "finance",
        "support"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    }
  }
}
