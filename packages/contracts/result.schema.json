{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fde.result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "sourceHash",
    "total",
    "accepted",
    "rows",
    "issues",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "field",
          "code",
          "message"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 2
          },
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "version",
          "durationMs"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
