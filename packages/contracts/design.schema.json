{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fde.design.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "stage": {
      "enum": [
        "draft",
        "review_ready"
      ]
    },
    "decisionOwner": {
      "type": "string",
      "minLength": 8
    },
    "problem": {
      "type": "string",
      "minLength": 8
    },
    "currentWorkflow": {
      "type": "string",
      "minLength": 8
    },
    "decisionToSupport": {
      "type": "string",
      "minLength": 8
    },
    "nonGoals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "kind": {
            "enum": [
              "official_case",
              "public_dataset",
              "synthetic",
              "human_observation",
              "lab_measurement"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 3
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "supports": {
            "type": "string",
            "minLength": 8
          },
          "limits": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "checkedAt",
          "supports",
          "limits"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "need": {
            "type": "string",
            "minLength": 8
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "acceptance": {
            "type": "string",
            "minLength": 8
          },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          }
        },
        "required": [
          "id",
          "need",
          "sourceIds",
          "acceptance",
          "scenarioIds"
        ]
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "method": {
            "type": "string",
            "minLength": 8
          },
          "mechanism": {
            "type": "string",
            "minLength": 8
          },
          "dataNeeded": {
            "type": "string",
            "minLength": 8
          },
          "worksWhen": {
            "type": "string",
            "minLength": 8
          },
          "failsWhen": {
            "type": "string",
            "minLength": 8
          },
          "costAndOperations": {
            "type": "string",
            "minLength": 8
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "disposition": {
            "enum": [
              "selected",
              "rejected",
              "conditional"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "id",
          "method",
          "mechanism",
          "dataNeeded",
          "worksWhen",
          "failsWhen",
          "costAndOperations",
          "evidenceIds",
          "disposition",
          "reason"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "statement": {
            "type": "string",
            "minLength": 8
          },
          "impact": {
            "type": "string",
            "minLength": 8
          },
          "verification": {
            "type": "string",
            "minLength": 8
          },
          "blocks": {
            "enum": [
              "execution",
              "investment",
              "answer",
              "none"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "impact",
          "verification",
          "blocks"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "trigger": {
            "type": "string",
            "minLength": 8
          },
          "expectedResponse": {
            "type": "string",
            "minLength": 8
          },
          "requiredDesignChange": {
            "type": "string",
            "minLength": 8
          },
          "alternativeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "evaluationMethod": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "id",
          "trigger",
          "expectedResponse",
          "requiredDesignChange",
          "alternativeIds",
          "evaluationMethod"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "kind": {
            "enum": [
              "source_report",
              "hypothesis",
              "synthetic_result",
              "empirical_outcome"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 8
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "limit": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "sourceIds",
          "limit"
        ]
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 8
        },
        "identityBoundary": {
          "type": "string",
          "minLength": 8
        },
        "dataBoundary": {
          "type": "string",
          "minLength": 8
        },
        "capacityModel": {
          "type": "string",
          "minLength": 8
        },
        "failureRecovery": {
          "type": "string",
          "minLength": 8
        },
        "releaseRollback": {
          "type": "string",
          "minLength": 8
        },
        "observability": {
          "type": "string",
          "minLength": 8
        },
        "operatingOwner": {
          "type": "string",
          "minLength": 8
        }
      },
      "required": [
        "runtime",
        "identityBoundary",
        "dataBoundary",
        "capacityModel",
        "failureRecovery",
        "releaseRollback",
        "observability",
        "operatingOwner"
      ]
    },
    "nextValidation": {
      "type": "string",
      "minLength": 8
    },
    "executionAllowed": {
      "const": false
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "painPoint",
        "valueHypothesis",
        "technicalCombination",
        "scaleTrigger",
        "weaknessCounterargument",
        "nextCheck"
      ],
      "properties": {
        "background": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "painPoint": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "valueHypothesis": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "technicalCombination": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "scaleTrigger": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "weaknessCounterargument": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        },
        "nextCheck": {
          "type": "string",
          "minLength": 8,
          "maxLength": 240
        }
      }
    },
    "critiques": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lens",
          "challenge",
          "response",
          "residualRisk"
        ],
        "properties": {
          "lens": {
            "type": "string",
            "minLength": 8
          },
          "challenge": {
            "type": "string",
            "minLength": 8
          },
          "response": {
            "type": "string",
            "minLength": 8
          },
          "residualRisk": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  },
  "required": [
    "version",
    "id",
    "stage",
    "decisionOwner",
    "problem",
    "currentWorkflow",
    "decisionToSupport",
    "nonGoals",
    "sources",
    "requirements",
    "alternatives",
    "assumptions",
    "scenarios",
    "claims",
    "deployment",
    "nextValidation",
    "executionAllowed",
    "brief",
    "critiques"
  ]
}
